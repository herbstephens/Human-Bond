# Mock mode for local UI development (1 = mock data, 0/unset = real chain).
# Never set to 1 in production — next.config.ts fails the build if you do.
NEXT_PUBLIC_USE_MOCKS=0

# 0G Router - Mainnet
ZG_ROUTER_API_KEY=
ZG_ROUTER_BASE_URL=https://router-api.0g.ai/v1
ZG_ROUTER_MODEL=zai-org/GLM-5-FP8

# 0G Router — Testnet (Qwen 7B, free — onboarding voice)
ZG_ROUTER_FAST_API_KEY=
ZG_ROUTER_FAST_BASE_URL=https://router-api-testnet.integratenetwork.work/v1
ZG_ROUTER_MODEL_FAST=qwen/qwen2.5-omni-7b

# 
NEXT_PUBLIC_WORLDCHAIN_RPC=https://worldchain-mainnet.g.alchemy.com/public
NEXT_PUBLIC_HUMANBOND_CONTRACT=
NEXT_PUBLIC_TIME_TOKEN=
NEXT_PUBLIC_VOWNFT=
NEXT_PUBLIC_SUBGRAPH_URL=https://api.thegraph.com/subgraphs/name/humanbond/partnership-registry
NEXT_PUBLIC_ENS_REGISTRAR=0x[humanbond.eth subname registrar]
NEXT_PUBLIC_WLD_APP_ID=app_[your_app_id]

# Stellar joint account (lib/stellar). Network: testnet (default) or public.
NEXT_PUBLIC_STELLAR_NETWORK=testnet
# Domain serving /.well-known/stellar.toml + /api/federation; written into each joint account's home_domain.
NEXT_PUBLIC_STELLAR_HOME_DOMAIN=
# Testnet-only stand-in for the ENS text record proof: label=G…,label=G…  (refused on mainnet)
STELLAR_TESTNET_DIRECTORY=
